# Staff Portal · © cmeproject
# Copy this file to .env.local and fill in the values for ONE company.
# Never commit .env.local. In Vercel (or another host) add the same names
# under the project's Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret: server only. Never put this in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The web address of this company's portal (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifications (Resend: resend.com → API Keys). Leave blank to keep
# emails queued until it's set up.
RESEND_API_KEY=
# Who emails come from, using a domain verified in Resend
EMAIL_FROM="Engaged Care <tasks@your-company-domain.com.au>"
# On your own computer only: the local test inbox from `npx supabase start`
# MAILPIT_URL=http://127.0.0.1:54324
