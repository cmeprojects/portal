# Staff Portal · © cmeproject
# Copy this file to .env.local and fill in the values for ONE company.
# Never commit .env.local. In Vercel (or another host) add the same names
# under the project's Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# cmeprojects: either name works (Supabase's Vercel connection uses NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret: server only. Never put this in a NEXT_PUBLIC_ variable.
# Either name works (or SUPABASE_SECRET_KEY)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The web address of this company's portal (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: label shown at the top of a non-live copy, e.g. DEVELOPMENT or DEMO. Leave out on client copies.
# NEXT_PUBLIC_ENV_LABEL=DEVELOPMENT

# Email notifications (Resend: resend.com → API Keys). Leave blank to keep
# emails queued until it's set up.
RESEND_API_KEY=
# Who emails come from, using a domain verified in Resend
EMAIL_FROM="Your Company <tasks@your-company-domain.com.au>"
# Secret for the hourly due date timer (at least 32 characters). Make one with:
#   openssl rand -hex 32
# Put the same value in Supabase (see docs/SETUP.md, "Due date alerts").
CRON_SECRET=

# On your own computer only: the local test inbox from `npx supabase start`
# MAILPIT_URL=http://127.0.0.1:54324

# Website and Assistant: lets the website write answers from your documents
# (console.anthropic.com → API keys). Leave blank to show what the documents
# say instead. Secret: server only, never a NEXT_PUBLIC_ variable.
ANTHROPIC_API_KEY=
